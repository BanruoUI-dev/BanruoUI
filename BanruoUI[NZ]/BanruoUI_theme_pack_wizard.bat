@echo off
setlocal EnableExtensions

set "BASE=%~dp0"
for %%I in ("%BASE:~0,-1%") do set "ADDON_DIR=%%~nI"

set "META_FILE=%BASE%ThemeMeta.lua"
if not exist "%META_FILE%" (
  echo [ERROR] ThemeMeta.lua not found in current folder.
  exit /b 1
)

for /f "delims=" %%i in ('powershell -NoProfile -Command "$p=$env:BASE; $files=Get-ChildItem -LiteralPath $p -File -Filter '*.toc'; if($files){$files[0].FullName}"') do set "TOC_FILE=%%i"
if not defined TOC_FILE (
  echo [ERROR] No .toc file found in current folder.
  exit /b 1
)

for %%I in ("%TOC_FILE%") do set "TOC_NAME=%%~nxI"
set "EXPECT_TOC_NAME=%ADDON_DIR%.toc"
if /I not "%TOC_NAME%"=="%EXPECT_TOC_NAME%" (
  if exist "%BASE%%EXPECT_TOC_NAME%" (
    echo [ERROR] Target toc already exists: %BASE%%EXPECT_TOC_NAME%
    exit /b 1
  )
  ren "%TOC_FILE%" "%EXPECT_TOC_NAME%"
  if errorlevel 1 (
    echo [ERROR] Failed to rename toc file.
    exit /b 1
  )
  set "TOC_FILE=%BASE%%EXPECT_TOC_NAME%"
)

for /f "delims=" %%i in ('powershell -NoProfile -Command "$n=$env:ADDON_DIR; if($n -match '\[(.+)\]'){ $matches[1] }"') do set "CUR_SUFFIX=%%i"
if not defined CUR_SUFFIX set "CUR_SUFFIX=Theme"

echo.
echo === In-place Theme Setup ===
echo Addon folder: %ADDON_DIR%
echo Toc file    : %TOC_FILE%
echo.

set /p "THEME_ID=Theme id/slug (blank to auto from suffix): "
if not defined THEME_ID (
  for /f %%i in ('powershell -NoProfile -Command "$s=$env:CUR_SUFFIX.ToLowerInvariant(); $s=[regex]::Replace($s,'[^a-z0-9]+','_'); $s=$s.Trim('_'); if([string]::IsNullOrWhiteSpace($s)){'theme'}else{$s}"') do set "THEME_ID=%%i"
)

set /p "TITLE_ZH=Zh title (default %CUR_SUFFIX%): "
if not defined TITLE_ZH set "TITLE_ZH=%CUR_SUFFIX%"

set /p "TITLE_EN=En title (default BanruoUI [%CUR_SUFFIX%]): "
if not defined TITLE_EN set "TITLE_EN=BanruoUI [%CUR_SUFFIX%]"

set /p "AUTHOR=Author (default BanruoUI): "
if not defined AUTHOR set "AUTHOR=BanruoUI"

set /p "VER=Version (default 1.0.0): "
if not defined VER set "VER=1.0.0"

set "THEME_NAME=BANRUOUI[%CUR_SUFFIX%]"
set "BRE_ID=banruoui_%THEME_ID%_bre_main"
set "ELV_ID=banruoui_%THEME_ID%_elv_profile"
set "PREVIEW_PATH=Interface\AddOns\%ADDON_DIR%\Media\Previews\preview.tga"

echo.
echo [1/2] Rewrite ThemeMeta.lua ...
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 1 (
  echo [ERROR] Failed updating ThemeMeta.lua/toc.
  exit /b 1
)

echo [2/2] Update toc headers ...
echo done by same script.

echo.
echo Done. Updated files:
echo   %META_FILE%
echo   %TOC_FILE%
echo.
echo Next:
echo   1) Replace BRE strings in Data_Bre_zh.lua and Data_Bre_en.lua
echo   2) Replace ElvUI string in Data_ElvUI.lua
echo.

endlocal


